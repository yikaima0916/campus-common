{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-common",
  "account_id": "b9f6bf4c077b60ef468ed069ac334d62",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-companion-i4i",
      "database_id": "2ef415cd-56b9-4f37-9f75-b7f19cbdd968",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "APP_ORIGIN": "https://campus-common.campus-companion.workers.dev",
    "ALTERNATE_APP_ORIGIN": "https://campus-common.pages.dev",
    "ENABLE_AI": "true",
    "MAIL_AI_DAILY_NEURONS": "10000"
  }
}
