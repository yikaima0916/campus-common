{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-common",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-companion-i4i",
      "database_id": "REPLACE_WITH_YOUR_I4I_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://campus-common.campus-companion.workers.dev",
    "ENABLE_AI": "false"
  }
}
